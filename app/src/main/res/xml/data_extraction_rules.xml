<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="hydro_tracker.db"/>
        <include domain="database" path="hydro_tracker.db-wal"/>
        <include domain="database" path="hydro_tracker.db-shm"/>
        <include domain="sharedpref" path="hydration_prefs.xml"/>
        <exclude domain="file" path="datastore/active_session.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="hydro_tracker.db"/>
        <include domain="database" path="hydro_tracker.db-wal"/>
        <include domain="database" path="hydro_tracker.db-shm"/>
        <include domain="sharedpref" path="hydration_prefs.xml"/>
        <exclude domain="file" path="datastore/active_session.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
